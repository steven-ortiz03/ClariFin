  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy en Bogotá (UTC-5) y correo único por ejecución.",
          "const hoy = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('hoy', hoy);",
          "pm.collectionVariables.set('periodo', hoy.slice(0, 7));",
          "if (pm.info.requestName === 'Registrar perfil')",
          "  pm.collectionVariables.set('email', 'demo-' + Date.now() + '@example.com');",
          "// Encabezados que exige la API en las operaciones de escritura.",
          "if (pm.request.method !== 'GET') {",
          "  pm.request.headers.upsert({ key: 'X-CSRF-Token', value: pm.collectionVariables.get('csrf') || '' });",
          "  pm.request.headers.upsert({ key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}') });",
          "}"
        ]
      }
    }
  ],
